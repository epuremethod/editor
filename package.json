{
  "name": "editor-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "res:build": "pnpm -r --workspace-concurrency=1 res:build",
    "format": "pnpm -r format",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "docs": "pnpm --filter editor-docs build",
    "dev": "pnpm --filter editor-docs dev"
  }
}
